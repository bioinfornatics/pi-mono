# Copy to .env and fill in values
# (Do NOT commit .env)

# =========================================
# Mode A (recommended for Foundry projects): Entra ID via DefaultAzureCredential
# =========================================

# Azure AI Foundry project endpoint
# Format: https://<resource-name>.services.ai.azure.com/api/projects/<project-name>
AZURE_FOUNDRY_ENDPOINT="https://<resource-name>.services.ai.azure.com/api/projects/<project-name>"

# OpenAI deployment name configured in your Foundry project (NOT the model id)
AZURE_FOUNDRY_DEPLOYMENT_NAME="<deployment-name>"

# Optional: OpenAI API version for the project OpenAI-compatible route
AZURE_FOUNDRY_API_VERSION="2024-10-21"

# Optional: purely cosmetic label for logs
AZURE_FOUNDRY_MODEL_ID="gpt-4o-mini"

# =========================================
# Mode B (API key): Azure OpenAI /openai/v1 endpoint (NOT Foundry project endpoint)
# =========================================

# If you set AZURE_OPENAI_API_KEY + AZURE_OPENAI_BASE_URL, the test harness
# will use api=azure-openai-responses instead of azure-foundry.
AZURE_OPENAI_API_KEY=""
AZURE_OPENAI_BASE_URL="https://<resource-name>.openai.azure.com/openai/v1"

# Optional: Azure OpenAI API version (default is provider's DEFAULT_AZURE_API_VERSION = v1)
AZURE_OPENAI_API_VERSION="v1"

# Azure OpenAI deployment name (NOT model id)
AZURE_OPENAI_DEPLOYMENT_NAME="<deployment-name>"

# Optional: pin tenant for AzureCliCredential debug script
AZURE_TENANT_ID="<tenant-guid>"
